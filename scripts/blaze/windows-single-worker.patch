+pub fn compute_workers() -> usize {
+    let available = std::thread::available_parallelism().map_or(1, NonZeroUsize::get);
+    let jobs = std::env::var_os("CARGO_BUILD_JOBS")
+        .map(|it| it.into_string().expect("CARGO_BUILD_JOBS must be a positive integer"));
+    configured_workers(jobs.as_deref(), available).unwrap_or_else(|why| panic!("{why}: {jobs:?}"))
+}
+
+fn configured_workers(jobs: Option<&str>, available: usize) -> Result<usize, &'static str> {
+    match jobs {
+        None => Ok(available),
+        Some(jobs) => jobs
+            .parse::<NonZeroUsize>()
+            .map(NonZeroUsize::get)
+            .map_err(|_| "CARGO_BUILD_JOBS must be a positive integer"),
+    }
+}
